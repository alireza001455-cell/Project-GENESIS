* text=auto
*.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cs text eol=lf
*.json text eol=lf
*.asmdef text eol=lf
*.inputactions text eol=lf
# Unity serializes empty YAML values with a trailing space. Preserve that output.
*.asset text eol=lf whitespace=-blank-at-eol
*.unity text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
